<Window x:Class="FenceDesk.Windows.ArchiveProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在处理"
        Width="486" Height="208"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Microsoft YaHei UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border CornerRadius="14" Background="#F612161F" BorderBrush="#38FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.55" Color="#000000" />
        </Border.Effect>
        <Grid Margin="24,18,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock x:Name="TitleText" Text="正在解压" Foreground="#F4F6FA" FontSize="15"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Style="{StaticResource ChromeButton}" Width="28" Height="26"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="Cancel_Click" ToolTip="取消">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Button>
            </Grid>

            <TextBlock x:Name="TargetText" Grid.Row="1" Foreground="#8B96A9" FontSize="10.5"
                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />

            <ProgressBar x:Name="Bar" Grid.Row="2" Height="7" Minimum="0" Maximum="1" Value="0"
                         Margin="0,14,0,0" Foreground="{StaticResource AccentBrush}">
                <ProgressBar.Template>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <Border Background="#1AFFFFFF" CornerRadius="3.5" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    CornerRadius="3.5" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </ProgressBar.Template>
            </ProgressBar>

            <TextBlock x:Name="EntryText" Grid.Row="3" Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="10.5" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"
                       Text="正在准备…" />

            <Grid Grid.Row="4" Margin="0,10,0,0">
                <TextBlock x:Name="DetailText" Foreground="{StaticResource TextMutedBrush}" FontSize="10"
                           VerticalAlignment="Center" Text="0%" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="取消" Style="{StaticResource GhostButton}"
                            Width="78" Click="Cancel_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
