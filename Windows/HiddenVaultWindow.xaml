<Window x:Class="FenceDesk.Windows.HiddenVaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="隐藏围栏"
        Width="760" Height="620"
        MinWidth="600" MinHeight="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI">
    <Border Background="#F512161F" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="14">
        <Grid Margin="22,18,22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Background="#01000000" MouseLeftButtonDown="Header_MouseLeftButtonDown"
                  Cursor="SizeAll">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="隐藏围栏" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="17" FontWeight="SemiBold" Margin="9,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="CountText" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <Button Style="{StaticResource ChromeButton}" Width="30" Height="28"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="Close_Click" ToolTip="关闭">
                    <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8BB;" FontSize="11" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,14,0,0">
                <StackPanel x:Name="LockPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed" MaxWidth="360">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="此隐藏围栏已加锁" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0" />
                    <TextBlock Text="输入密码后才能查看和打开其中的内容" FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"
                               Margin="0,5,0,12" />
                    <PasswordBox x:Name="UnlockPassword" Height="34" FontSize="12" Padding="9,0"
                                 Background="#1AFFFFFF" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="#30FFFFFF" />
                    <TextBlock x:Name="UnlockError" Foreground="{StaticResource DangerBrush}" FontSize="9.5"
                               HorizontalAlignment="Center" Margin="0,7,0,0" />
                    <Button Content="解锁" Style="{StaticResource AccentButton}" Width="112" Height="32"
                            Margin="0,10,0,0" Click="Unlock_Click" />
                </StackPanel>

                <Grid x:Name="ContentPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <WrapPanel>
                        <Button Content="添加文件" Style="{StaticResource GhostButton}" Height="28"
                                Padding="12,0" Click="AddFile_Click" Margin="0,0,7,7" />
                        <Button Content="添加文件夹" Style="{StaticResource GhostButton}" Height="28"
                                Padding="12,0" Click="AddFolder_Click" Margin="0,0,7,7" />
                        <Button x:Name="PasswordButton" Content="设置密码" Style="{StaticResource GhostButton}"
                                Height="28" Padding="12,0" Click="Password_Click" Margin="0,0,7,7" />
                        <Button Content="刷新" Style="{StaticResource GhostButton}" Height="28"
                                Padding="12,0" Click="Refresh_Click" Margin="0,0,7,7" />
                    </WrapPanel>

                    <Grid Grid.Row="1" Margin="0,5,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ItemsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PanelSolidBrush}" BorderBrush="{StaticResource StrokeBrush}"
                                                BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="11.5"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Path}" FontSize="9"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <Button Content="打开" Style="{StaticResource GhostButton}"
                                                            Height="25" Padding="10,0" Click="OpenItem_Click" />
                                                    <Button Content="取消隐藏" Style="{StaticResource GhostButton}"
                                                            Height="25" Padding="10,0" Margin="6,0,0,0"
                                                            Click="RestoreItem_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                       Foreground="#4DFFFFFF" HorizontalAlignment="Center" />
                            <TextBlock Text="隐藏围栏是空的" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <TextBlock Text="从围栏右键菜单或资源管理器“添加到 FenceDesk 隐藏围栏”加入内容"
                                       FontSize="9.5" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,5,0,0" TextAlignment="Center"
                                       MaxWidth="430" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <TextBlock Grid.Row="2" Text="隐藏使用 Windows Hidden 属性并移出其他围栏；密码只保护入口，不是文件加密。FenceDesk 关闭后文件仍保持隐藏。"
                       FontSize="9" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                       Margin="0,12,0,0" />
        </Grid>
    </Border>
</Window>
