<Window x:Class="FenceDesk.Windows.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名"
        Width="460" Height="214"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Microsoft YaHei UI">
    <Border CornerRadius="14" Background="#F60E1118" BorderBrush="#2EFFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="10" Direction="270" Opacity="0.6" Color="#000000" />
        </Border.Effect>
        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Text="重命名" Foreground="#F4F6FA" FontSize="15"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="PromptText" Grid.Row="1" Text="输入新名称" Foreground="#8B96A9"
                       FontSize="10.5" Margin="0,5,0,10" />

            <StackPanel Grid.Row="2">
                <TextBox x:Name="ValueBox" Style="{StaticResource DarkTextBox}" FontSize="13"
                         Height="34" KeyDown="ValueBox_KeyDown" />
                <TextBlock x:Name="ValidationText" Foreground="#FF7D8E" FontSize="10"
                           Margin="2,5,0,0" Visibility="Collapsed" Text="名称不能为空。" />
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="取消" Style="{StaticResource GhostButton}" Width="72" Click="Cancel_Click"
                        Margin="0,0,8,0" />
                <Button Content="确定" Style="{StaticResource AccentButton}" Width="76" Click="Ok_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
