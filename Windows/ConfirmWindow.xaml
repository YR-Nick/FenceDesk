<Window x:Class="FenceDesk.Windows.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="清空回收站"
        Width="470" Height="230"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Microsoft YaHei UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border CornerRadius="14" Background="#F612161F" BorderBrush="#38FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.55" Color="#000000" />
        </Border.Effect>
        <Grid Margin="24,18,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock x:Name="TitleText" Foreground="#F4F6FA" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Style="{StaticResource ChromeButton}" Width="28" Height="26"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="No_Click" ToolTip="关闭">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Button>
            </Grid>
            <TextBlock x:Name="MessageText" Grid.Row="1" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,12,0,12" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="NoButton" Content="取消" Style="{StaticResource GhostButton}" Width="82"
                        Click="No_Click" Margin="0,0,8,0" />
                <Button x:Name="YesButton" Content="确定" Style="{StaticResource AccentButton}" Width="88"
                        Click="Yes_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
