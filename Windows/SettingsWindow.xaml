<Window x:Class="FenceDesk.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FenceDesk 设置"
        Icon="pack://application:,,,/Assets/FenceDesk.ico"
        Width="560" Height="760"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        FontFamily="Microsoft YaHei UI">
    <Border CornerRadius="18" Background="#F70E1118" BorderBrush="#2EFFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.62" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
                <RowDefinition Height="1" />
                <RowDefinition Height="68" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="18,18,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="22,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="9" Background="#12FFFFFF" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="25" Height="25"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,0,0">
                        <TextBlock Text="设置" Foreground="#F4F6FA" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="FenceDesk · 桌面围栏" Foreground="#8B96A9" FontSize="9.5" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource ChromeButton}" Click="Close_Click" ToolTip="关闭">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE711;" FontSize="13" />
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#14FFFFFF" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="22,18,18,20">
                <StackPanel>
                    <TextBlock Text="桌面接管" Foreground="#33D6C0" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <CheckBox x:Name="HideIconsCheck" Content="隐藏系统桌面图标（推荐）" Click="HideIconsCheck_Click" />
                    <TextBlock Text="由 FenceDesk 接管桌面图标显示，退出程序或关闭此选项时自动恢复。"
                               Foreground="#8B96A9" FontSize="10" TextWrapping="Wrap" Margin="29,5,0,0" />
                    <TextBlock x:Name="IconStatusText" Foreground="#8F9AAD" FontSize="10" Margin="29,4,0,8" />

                    <CheckBox x:Name="DoubleClickCheck" Content="双击桌面空白处隐藏 / 显示围栏"
                              Click="SimpleSetting_Click" Margin="0,4,0,0" />
                    <CheckBox x:Name="AutoImportCheck" Content="自动收纳新出现在桌面的文件"
                              Click="SimpleSetting_Click" Margin="0,12,0,0" />
                    <CheckBox x:Name="IncludeHiddenCheck" Content="扫描隐藏 / 系统桌面项目（高级）"
                              Click="SimpleSetting_Click" Margin="0,12,0,0" />
                    <CheckBox x:Name="MusicIslandCheck" Content="显示音乐节奏浮动岛"
                              Click="SimpleSetting_Click" Margin="0,12,0,0" />
                    <TextBlock Text="桌面精灵常驻显示；播放音乐时展开，均衡器随系统音量起伏；空闲时是两条竖线小眼睛，会跟随鼠标，可拖动、不抢焦点。"
                               Foreground="#8B96A9" FontSize="10" TextWrapping="Wrap" Margin="29,5,0,0" />
                    <TextBlock Text="系统图标（回收站、此电脑等）不会放进围栏；关闭“隐藏系统桌面图标”可在桌面显示它们。"
                               Foreground="#8B96A9" FontSize="10" TextWrapping="Wrap" Margin="29,5,0,0" />

                    <Border Height="1" Background="#12FFFFFF" Margin="0,16,0,14" />

                    <TextBlock Text="外观" Foreground="#33D6C0" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <CheckBox x:Name="ShowDockCheck" Content="显示右下角控制条"
                              Click="ShowDockCheck_Click" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="图标大小" Foreground="#E8EDF5" FontSize="12.5" />
                            <TextBlock Text="在围栏中显示更大的图标" Foreground="#8B96A9" FontSize="10" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ToggleButton x:Name="SizeSmall" Content="小" Tag="34" Style="{StaticResource SegmentButton}"
                                          Click="SizeButton_Click" Margin="0,0,6,0" />
                            <ToggleButton x:Name="SizeMedium" Content="中" Tag="42" Style="{StaticResource SegmentButton}"
                                          Click="SizeButton_Click" Margin="0,0,6,0" />
                            <ToggleButton x:Name="SizeLarge" Content="大" Tag="48" Style="{StaticResource SegmentButton}"
                                          Click="SizeButton_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="#12FFFFFF" Margin="0,16,0,14" />

                    <TextBlock Text="启动" Foreground="#33D6C0" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <CheckBox x:Name="AutoStartCheck" Content="登录 Windows 后自动启动 FenceDesk"
                              Checked="AutoStartCheck_Changed" Unchecked="AutoStartCheck_Changed" />
                    <TextBlock Text="优先写入当前用户注册表 Run 项；如果被权限策略拒绝，会自动尝试启动文件夹。"
                               Foreground="#8B96A9" FontSize="10" TextWrapping="Wrap" Margin="29,5,0,0" />
                    <TextBlock x:Name="AutoStartStatusText" Foreground="#FFB86B" FontSize="10"
                               TextWrapping="Wrap" Margin="29,5,0,0" />
                    <WrapPanel Margin="29,7,0,0">
                        <Button Content="生成启动快捷方式" Style="{StaticResource GhostButton}"
                                Click="GenerateStartupShortcut_Click" Margin="0,0,8,0" Height="27" FontSize="10.5" />
                        <Button Content="打开启动文件夹" Style="{StaticResource GhostButton}"
                                Click="OpenStartup_Click" Height="27" FontSize="10.5" />
                    </WrapPanel>

                    <Border Height="1" Background="#12FFFFFF" Margin="0,16,0,14" />

                    <TextBlock Text="布局与数据" Foreground="#33D6C0" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <WrapPanel>
                        <Button Content="重新扫描桌面" Style="{StaticResource GhostButton}" Click="Rescan_Click" Margin="0,0,8,8" />
                        <Button Content="导出布局" Style="{StaticResource GhostButton}" Click="Export_Click" Margin="0,0,8,8" />
                        <Button Content="导入布局" Style="{StaticResource GhostButton}" Click="Import_Click" Margin="0,0,8,8" />
                        <Button Content="打开数据目录" Style="{StaticResource GhostButton}" Click="OpenData_Click" Margin="0,0,8,8" />
                        <Button Content="恢复忽略项" Style="{StaticResource GhostButton}" Click="ClearIgnored_Click" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock x:Name="ActionStatusText" Foreground="#7ED6A5" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock x:Name="DataPathText" Foreground="#7A8699" FontSize="9.5" TextWrapping="Wrap" Margin="0,4,0,0" />

                    <Border Height="1" Background="#12FFFFFF" Margin="0,16,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="10" Background="#12FFFFFF" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/logo.png" Width="30" Height="30"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,0,0">
                            <TextBlock Text="FenceDesk 1.3.42" Foreground="#DDE4EE" FontSize="11.5" />
                            <TextBlock Text="一个受 Fences 启发的 Windows 桌面整理工具。所有桌面文件都留在原位。"
                                       Foreground="#8792A5" FontSize="9.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" Background="#12FFFFFF" />
            <Grid Grid.Row="4" Margin="22,0,22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="恢复默认布局" Style="{StaticResource DangerGhostButton}" Click="Reset_Click"
                        VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="完成" Style="{StaticResource AccentButton}" Click="Close_Click"
                        VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
