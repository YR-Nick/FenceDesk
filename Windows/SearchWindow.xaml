<Window x:Class="FenceDesk.Windows.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="搜索围栏"
        Width="720" Height="540"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        FontFamily="Microsoft YaHei UI">
    <Border CornerRadius="18" Background="#F50E1118" BorderBrush="#2EFFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="38" ShadowDepth="12" Direction="270" Opacity="0.6" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
                <RowDefinition Height="1" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="20,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="#33D6C0"
                           VerticalAlignment="Center" Margin="0,0,14,0" />
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBox x:Name="QueryBox" Style="{StaticResource DarkTextBox}" Background="Transparent"
                             BorderThickness="0" FontSize="16" Padding="2,0" Height="36"
                             VerticalContentAlignment="Center" TextChanged="QueryBox_TextChanged" />
                    <TextBlock x:Name="QueryPlaceholder" Text="搜索围栏中的程序、文件或文件夹…"
                               FontSize="15" Foreground="#667082" VerticalAlignment="Center"
                               Margin="4,0,0,0" IsHitTestVisible="False" />
                </Grid>
                <Button Grid.Column="2" Style="{StaticResource ChromeButton}" Click="Close_Click" ToolTip="关闭 (Esc)">
                    <TextBlock Style="{StaticResource GlyphText}" Text="&#xE711;" FontSize="13" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Background="#14FFFFFF" />

            <Grid Grid.Row="2" Margin="8,8,8,4">
                <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         HorizontalContentAlignment="Stretch"
                         MouseDoubleClick="ResultsList_MouseDoubleClick"
                         SelectionChanged="ResultsList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                                Padding="10,8">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1EFFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="30" Height="30" VerticalAlignment="Center">
                                    <Border CornerRadius="7" Background="#12FFFFFF" />
                                    <TextBlock Text="{Binding ExtensionLabel}" FontSize="7.5" Foreground="#8C97A8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding Icon}" Width="30" Height="30" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,10,0">
                                    <TextBlock Text="{Binding Name}" Foreground="#F0F4FA" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Path}" Foreground="#8B96A9" FontSize="10"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="2" CornerRadius="6" Background="{Binding Accent.SoftBrush}"
                                        Padding="7,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FenceTitle}" Foreground="{Binding Accent.Brush}"
                                               FontSize="9.5" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                               Foreground="#3DFFFFFF" HorizontalAlignment="Center" />
                    <TextBlock Text="没有找到匹配的项目" Foreground="#6F7A8C" FontSize="12"
                               Margin="0,10,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="3" Background="#12FFFFFF" />
            <Grid Grid.Row="4" Margin="20,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="↑↓ 选择 · Enter 打开 · Esc 关闭" Foreground="#8B96A9" FontSize="10"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="CountText" Grid.Column="1" Text="" Foreground="#8B96A9" FontSize="10"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
