<Window x:Class="FenceDesk.Windows.ArchiveConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="同名文件"
        Width="540" Height="286"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Microsoft YaHei UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border CornerRadius="14" Background="#F612161F" BorderBrush="#38FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.55" Color="#000000" />
        </Border.Effect>
        <Grid Margin="24,18,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock Text="目标位置已有同名文件" Foreground="#F4F6FA" FontSize="15"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Style="{StaticResource ChromeButton}" Width="28" Height="26"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="Cancel_Click" ToolTip="取消">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Background="#10FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                    CornerRadius="9" Padding="12,10" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock x:Name="NameText" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ExistingText" Foreground="{StaticResource TextMutedBrush}" FontSize="10"
                               Margin="0,5,0,0" />
                    <TextBlock x:Name="IncomingText" Foreground="{StaticResource TextMutedBrush}" FontSize="10"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <CheckBox x:Name="ApplyAllBox" Grid.Row="2" Content="对后面所有冲突都使用这个选择"
                      Margin="2,14,0,0" />

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="取消" Style="{StaticResource GhostButton}" Width="76" Click="Cancel_Click"
                        Margin="0,0,8,0" />
                <Button Content="两者都保留" Style="{StaticResource GhostButton}" Width="96"
                        Click="KeepBoth_Click" Margin="0,0,8,0" />
                <Button x:Name="SkipButton" Content="跳过" Style="{StaticResource GhostButton}" Width="76"
                        Click="Skip_Click" Margin="0,0,8,0" />
                <Button Content="覆盖" Style="{StaticResource AccentButton}" Width="84" Click="Overwrite_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
