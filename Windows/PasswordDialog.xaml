<Window x:Class="FenceDesk.Windows.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="430" Height="230"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Microsoft YaHei UI">
    <Border Background="#F512161F" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="14">
        <Grid Margin="22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Foreground="#F4F6FA" FontSize="15" FontWeight="SemiBold" />
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock x:Name="MessageText" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,10" />
                <PasswordBox x:Name="PasswordInput" Height="32" FontSize="12" Padding="9,0"
                             Background="#1AFFFFFF" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="#30FFFFFF" />
                <PasswordBox x:Name="ConfirmInput" Height="32" FontSize="12" Padding="9,0" Margin="0,8,0,0"
                             Background="#1AFFFFFF" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="#30FFFFFF" />
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="9.5"
                           Margin="0,7,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource GhostButton}" Width="78" Click="Cancel_Click" />
                <Button Content="确定" Style="{StaticResource AccentButton}" Width="82" Margin="8,0,0,0"
                        Click="Ok_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
