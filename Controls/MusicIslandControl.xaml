<UserControl x:Class="FenceDesk.Controls.MusicIslandControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="58" Height="58"
             Focusable="False"
             Background="Transparent"
             FontFamily="Microsoft YaHei UI">
    <Border x:Name="IslandBorder" CornerRadius="29" Background="#F012161F"
            BorderBrush="#48FFFFFF" BorderThickness="1"
            MouseLeftButtonDown="Island_MouseLeftButtonDown"
            MouseMove="Island_MouseMove"
            MouseLeftButtonUp="Island_MouseLeftButtonUp">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Canvas x:Name="EyesCanvas" Width="46" Height="34" HorizontalAlignment="Left"
                    VerticalAlignment="Center" Margin="6,0,0,0">
                <Rectangle x:Name="EyeLeft" Width="5" Height="19" RadiusX="2.5" RadiusY="2.5"
                           Fill="#E8FFFB" Canvas.Left="8" Canvas.Top="8">
                    <Rectangle.Effect>
                        <DropShadowEffect BlurRadius="7" ShadowDepth="0" Opacity="0.65" Color="#33D6C0" />
                    </Rectangle.Effect>
                </Rectangle>
                <Rectangle x:Name="EyeRight" Width="5" Height="19" RadiusX="2.5" RadiusY="2.5"
                           Fill="#E8FFFB" Canvas.Left="30" Canvas.Top="8">
                    <Rectangle.Effect>
                        <DropShadowEffect BlurRadius="7" ShadowDepth="0" Opacity="0.65" Color="#33D6C0" />
                    </Rectangle.Effect>
                </Rectangle>
            </Canvas>

            <StackPanel x:Name="BarsPanel" Orientation="Horizontal" Height="30"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,14,0" Opacity="0" IsHitTestVisible="False" />
        </Grid>
    </Border>
</UserControl>
