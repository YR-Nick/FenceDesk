<UserControl x:Class="FenceDesk.Controls.FenceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:FenceDesk.Models"
             x:Name="Root"
             Background="Transparent"
             AllowDrop="True"
             Focusable="False"
             FontFamily="Microsoft YaHei UI"
             Drop="Fence_Drop"
             DragOver="Fence_DragOver"
             MouseRightButtonDown="Fence_MouseRightButtonDown"
             PreviewMouseLeftButtonDown="Fence_PreviewMouseLeftButtonDown">
    <Grid>
        <Border x:Name="Shell" CornerRadius="14" BorderThickness="1" BorderBrush="#2AFFFFFF" SnapsToDevicePixels="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#E61A1E28" Offset="0" />
                    <GradientStop Color="#D40E1118" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="7" Direction="270" Opacity="0.5" Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="Header" Grid.Row="0" Background="Transparent" CornerRadius="14,14,0,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown"
                        MouseMove="Header_MouseMove"
                        MouseLeftButtonUp="Header_MouseLeftButtonUp"
                        MouseRightButtonDown="Header_MouseRightButtonDown"
                        LostMouseCapture="Header_LostMouseCapture">
                    <Grid Margin="13,0,7,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="AccentBar" Grid.Column="0" Width="3" Height="18" CornerRadius="2"
                                Background="#33D6C0" VerticalAlignment="Center" Margin="0,0,9,0" />

                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#F4F6FA" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                                       ToolTip="{Binding Title}" />
                            <TextBox x:Name="RenameBox" Style="{StaticResource DarkTextBox}" FontSize="12.5"
                                     Height="28" Padding="7,3" Visibility="Collapsed"
                                     KeyDown="RenameBox_KeyDown" LostFocus="RenameBox_LostFocus" />
                        </Grid>

                        <TextBlock x:Name="PortalGlyph" Grid.Column="2" Text="&#xE8B7;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#B7E8DF"
                                   VerticalAlignment="Center" Margin="0,0,7,0" Visibility="Collapsed"
                                   ToolTip="文件夹门户：实时显示文件夹内容" />

                        <Border x:Name="CountBadge" Grid.Column="3" CornerRadius="7" Background="#14FFFFFF"
                                Padding="7,2" VerticalAlignment="Center" Margin="0,0,5,0">
                            <TextBlock x:Name="CountText" Text="{Binding Count}" FontSize="10"
                                       Foreground="#AAB3C2" VerticalAlignment="Center" />
                        </Border>

                        <Button x:Name="CollapseButton" Grid.Column="4" Style="{StaticResource ChromeButton}"
                                Width="27" Height="27" Margin="0,0,1,0" Click="CollapseButton_Click"
                                ToolTip="卷起 / 展开">
                            <TextBlock x:Name="CollapseGlyph" Style="{StaticResource GlyphText}" Text="&#xE70E;" FontSize="10" />
                        </Button>

                        <Button x:Name="MoreButton" Grid.Column="5" Style="{StaticResource ChromeButton}"
                                Width="27" Height="27" Click="MoreButton_Click" ToolTip="围栏菜单">
                            <TextBlock Style="{StaticResource GlyphText}" Text="&#xE712;" FontSize="14" />
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="#12FFFFFF" />

                <Border x:Name="Body" Grid.Row="2" Background="Transparent" ClipToBounds="True">
                    <Grid>
                        <ScrollViewer x:Name="ItemsScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="6,3,4,9" PanningMode="VerticalOnly"
                                      ScrollChanged="ItemsScroll_ScrollChanged">
                            <ItemsControl x:Name="ItemsHost" ItemsSource="{Binding Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:FenceItemModel}">
                                        <Border x:Name="ItemBox" Width="76" Height="88" Margin="2,1" CornerRadius="9"
                                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                                ToolTip="{Binding TooltipText}" ToolTipService.InitialShowDelay="650"
                                                PreviewMouseLeftButtonDown="Item_MouseLeftButtonDown"
                                                MouseMove="Item_MouseMove"
                                                MouseLeftButtonUp="Item_MouseLeftButtonUp"
                                                MouseRightButtonDown="Item_MouseRightButtonDown">
                                            <StackPanel VerticalAlignment="Center">
                                                <Grid Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                      Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" HorizontalAlignment="Center">
                                                    <Border x:Name="IconTile" CornerRadius="9" Background="#0DFFFFFF"
                                                            BorderBrush="#14FFFFFF" BorderThickness="1" />
                                                    <TextBlock Text="{Binding ExtensionLabel}" FontSize="8.5"
                                                               Foreground="#8C97A8" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                                    <Image Source="{Binding Icon}" Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                           Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <Border x:Name="MissingDot" Width="8" Height="8" CornerRadius="4"
                                                            Background="#FF7D8E" BorderBrush="#1A1E28" BorderThickness="1.5"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Margin="0,-1,-1,0" Visibility="Collapsed" />
                                                </Grid>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="10.5"
                                                           Foreground="#CDD5E1" TextWrapping="Wrap"
                                                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           MaxHeight="29" LineHeight="13.5" Margin="1,5,1,0" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="ItemBox" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBox" Property="Background" Value="#16FFFFFF" />
                                                <Setter TargetName="ItemBox" Property="BorderBrush" Value="#20FFFFFF" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="ItemBox" Property="Background" Value="#22FFFFFF" />
                                                <Setter TargetName="ItemBox" Property="BorderBrush" Value="#3AFFFFFF" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                <Setter TargetName="ItemBox" Property="Opacity" Value="0.46" />
                                                <Setter TargetName="MissingDot" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    IsHitTestVisible="False" Visibility="Collapsed">
                            <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="23"
                                       Foreground="#4DFFFFFF" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyHintText" Text="拖入文件或快捷方式" FontSize="11" Foreground="#667080"
                                       Margin="0,7,0,0" HorizontalAlignment="Center" />
                        </StackPanel>

                        <Border x:Name="BottomFade" Height="26" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                Visibility="Collapsed">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#000E1118" Offset="0" />
                                    <GradientStop Color="#E80E1118" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="ResizeGrip" Grid.Row="2" Width="18" Height="18" Background="Transparent"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
                        MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                        MouseMove="ResizeGrip_MouseMove"
                        MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"
                        LostMouseCapture="ResizeGrip_LostMouseCapture"
                        ToolTip="拖动调整围栏大小">
                    <Path Data="M 8,17 L 17,8 M 13,17 L 17,13" Stroke="#5CFFFFFF" StrokeThickness="1.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
