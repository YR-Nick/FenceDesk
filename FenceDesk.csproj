<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\FenceDesk.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>FenceDesk</AssemblyName>
    <RootNamespace>FenceDesk</RootNamespace>
    <Version>1.3.22</Version>
    <FileVersion>1.3.22.0</FileVersion>
    <Company>FenceDesk</Company>
    <Product>FenceDesk 桌面围栏</Product>
    <Description>Fences 风格的 Windows 桌面整理工具</Description>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\FenceDesk.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="installer\**\*.cs" />
    <Compile Remove="_probe\**\*.cs" />
    <EmbeddedResource Remove="installer\**" />
    <None Remove="installer\**" />
    <Page Remove="installer\**" />
  </ItemGroup>

</Project>
